{
  "name": "buildy",
  "version": "0.1.0",
  "description": "A web-first editor for GitHub Pages projects",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "electron": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac dmg zip --universal --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "build": "node scripts/verify-build.js",
    "build:pages": "node scripts/build-pages.js",
    "serve:pages": "node scripts/serve-pages.js",
    "lint": "node --check server.js && node --check worker.js && node --check main.js && node --check lib/config.js && node --check lib/artifact-retention.js && node --check lib/entitlements.js && node --check lib/clone-workspace.js && node --check lib/github-app.js && node --check lib/build-jobs.js && node --check lib/postgres-job-store.js && node --check lib/project-build.js && node --check public/workspace-preview.js && node --check public/app.js && node --check static/static-api.js && node --check scripts/build-pages.js && node --check scripts/serve-pages.js",
    "pretest": "node scripts/hydrate-tests.js",
    "test": "node --test test/*.test.js",
    "pretest:e2e": "node scripts/hydrate-tests.js",
    "test:e2e": "playwright test",
    "pretest:electron": "node scripts/hydrate-tests.js",
    "test:electron": "playwright test --config playwright.electron.config.js",
    "test:pages": "playwright test --config playwright.pages.config.js",
    "test:all": "npm run lint && npm test && npm run test:e2e && npm run test:electron && npm run test:pages"
  },
  "keywords": [
    "github-pages",
    "editor",
    "web-editor",
    "electron"
  ],
  "author": "JakkuAzzo",
  "license": "Commercial",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "codemirror": "^5.65.16",
    "dompurify": "3.4.13",
    "express": "^4.18.2",
    "fflate": "^0.8.2",
    "helmet": "^7.0.0",
    "marked": "^17.0.0",
    "simple-git": "^3.24.0"
  },
  "build": {
    "appId": "com.jakkuazzo.buildy",
    "productName": "Buildy",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "worker.js",
      "server.js",
      "lib/**/*",
      "migrations/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "electron": "^39.2.1",
    "electron-builder": "^26.15.3"
  }
}
