# GitHub App OAuth credentials. Export these values before running npm start.
GITHUB_APP_CLIENT_ID=Iv1.example
GITHUB_APP_CLIENT_SECRET=replace-with-server-side-secret
GITHUB_APP_SLUG=your-github-app-slug
# Required for non-loopback deployments; must be HTTPS.
GITHUB_APP_CALLBACK_URL=https://editor.example.com/api/auth/github/callback
