{
  "name": "Buildy for GitHub Pages",
  "url": "https://buildy.bstudiob.co.uk/",
  "hook_attributes": {
    "url": "https://buildy.bstudiob.co.uk/api/github/marketplace/webhook"
  },
  "redirect_url": "https://buildy.bstudiob.co.uk/auth/github/callback",
  "public": true,
  "default_permissions": {
    "contents": "write",
    "metadata": "read"
  },
  "default_events": [
    "installation",
    "installation_repositories",
    "marketplace_purchase",
    "meta"
  ]
}
